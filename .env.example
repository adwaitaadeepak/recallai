# 1. Gemini API Key (Required for AI flashcard generation)
# Get a free API key at https://aistudio.google.com/app/apikey (Generous free tier: 15 req/min, 1M tokens/min, 1500 req/day)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Supadata API Key (Optional: enables automatic AI Whisper audio transcription for videos WITHOUT captions)
# Get a free key at https://supadata.ai (Free tier: 100 requests)
SUPADATA_API_KEY=your_supadata_api_key_here
